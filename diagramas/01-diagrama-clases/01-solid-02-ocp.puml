@startuml Diagrama_OCP_Extendido_ES
title OCP — Sistema Productora de Videos

skinparam classAttributeIconSize 0
skinparam packageStyle rectangle

class Proyecto {
  - projectId: UUID
  - nombre: String
  - cliente: String
  - fechaInicioEstimada: Date
  - fechaFinEstimada: Date
  - estado: EstadoProyecto
  - observaciones: String
  + agregarEtapa()
  + eliminarEtapa()
  + obtenerDuracionPromedioEtapas(): Duration
  + finalizarSiCorresponde(spec: EspecificacionProyectoFinalizable): void
}

class Etapa {
  - stageId: UUID
  - nombre: String
  + estadoActual: EstadoEtapa    
  - fechaInicioEstimada: Date
  - fechaFinEstimada: Date
  - fechaFinReal: Date
  - observaciones: String
  - responsable: Usuario
  + asignarResponsable()
  + cambiarEstado(nuevo: EstadoEtapa)
  + agregarComentario()
  + adjuntar()
}

abstract class EstadoEtapa {
  + cambiarEstado(e: Etapa, nuevo: EstadoEtapa)
  + agregarComentario(e: Etapa)
}

class Pendiente
class EnCurso
class Bloqueada
class Finalizada
EstadoEtapa <|-- Pendiente
EstadoEtapa <|-- EnCurso
EstadoEtapa <|-- Bloqueada
EstadoEtapa <|-- Finalizada

EstadoEtapa ..> Etapa : contexto

abstract class Usuario {
  - userId: UUID
  - nombre: String
  - email: String
  - rol: RolUsuario
  - canalPreferido: String
  + puedeGestionarProyectos(): boolean
  + puedeGestionarEtapas(): boolean
  + notificar(n: Notificacion)
}

class Comentario {
  - commentId: UUID
  - texto: String
  - fechaHora: DateTime
  - autor: Usuario
  + editarTexto()
  + eliminar()
  + mencionar()
}

class Adjunto {
  - attachId: UUID
  - titulo: String
  - url: String
  - tipo: String
  - fechaAdjunto: DateTime
  + generarPreview()
  + descargar()
  + eliminar()
}

class Notificacion {
  - notificationId: UUID
  - asunto: String
  - mensaje: String
  - fechaHora: DateTime
  - destino: Usuario
  - resultado: String
  + marcarLeida(): void
  + programarEnvio(): void
  + pendiente(): boolean
}

class DespachadorNotificaciones {
  - registro: Map<String, CanalNotificacion>
  + registrar(canalId: String, impl: CanalNotificacion)
  + enviarPor(canalId: String, n: Notificacion): ResultadoEnvio
}

interface CanalNotificacion {
  + enviar(n: Notificacion): ResultadoEnvio
}
class CanalEmail
class CanalWhatsApp
class CanalPush
class CanalSlack
CanalEmail ..|> CanalNotificacion
CanalWhatsApp ..|> CanalNotificacion
CanalPush ..|> CanalNotificacion
CanalSlack ..|> CanalNotificacion


interface EspecificacionProyectoFinalizable {
  + cumple(p: Proyecto): boolean
}
class EspecEtapasFinalizadas
class EspecSinBloqueos
class EspecAprobacionCliente
class EspecificacionY {
  - left: EspecificacionProyectoFinalizable
  - right: EspecificacionProyectoFinalizable
}
EspecificacionProyectoFinalizable <|.. EspecEtapasFinalizadas
EspecificacionProyectoFinalizable <|.. EspecSinBloqueos
EspecificacionProyectoFinalizable <|.. EspecAprobacionCliente
EspecificacionProyectoFinalizable <|.. EspecificacionY

Proyecto "1" o-- "1..*" Etapa : contiene
Etapa "0..*" o-- "0..*" Comentario : registra
Etapa "0..*" o-- "0..*" Adjunto : adjunta
Etapa "1" --> "1" Usuario : responsable
Etapa "1" *-- "1" EstadoEtapa : estadoActual
Notificacion --> Usuario : destino
Notificacion --> Etapa : sobre

Usuario --> DespachadorNotificaciones : usa
DespachadorNotificaciones o--> CanalNotificacion : resuelve/enruta
Proyecto --> EspecificacionProyectoFinalizable : usa

@enduml
