@startuml "ISP - Segregación de Interfaces"
skinparam classAttributeIconSize 0

' Interfaces especializadas
interface ISubirContenido {
  +subirVideo(titulo: String)
  +eliminarVideo(idVideo: String)
}
interface IReproducirContenido {
  +reproducirVideo(idVideo: String)
  +pausarVideo(idVideo: String)
}
interface IComentarContenido {
  +agregarComentario(idVideo: String, comentario: String)
  +eliminarComentario(idComentario: String)
}
interface IMonetizarContenido {
  +activarMonetizacion(idVideo: String)
  +consultarGanancias(): double
}

' Clases concretas
class Productor
class Espectador
class Administrador

' Implementaciones
Productor ..|> ISubirContenido
Productor ..|> IMonetizarContenido

Espectador ..|> IReproducirContenido
Espectador ..|> IComentarContenido

Administrador ..|> ISubirContenido

' Nota aclaratoria
note right of ISubirContenido
  Cada interfaz es específica y cohesiva.
  Evitamos una interfaz "gorda" como IGestionMultimedia
  que obligaría a todas las clases a implementar
  métodos que no utilizan.
end note

@enduml



