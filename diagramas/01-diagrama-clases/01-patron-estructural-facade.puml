@startuml Facade
title Patrón Estructural - Facade aplicado al sistema real

' ========== NUEVA FACHADA ==========
class SistemaProductoraFacade {
  +crearProyectoConEtapas(dto: ProyectoDTO, etapas: ListEtapas, actor: UUID) : Proyecto
  +notificarCambioEstado(etapaId: UUID, evento: TipoEvento, actor: UUID) : void
  +generarReporteProyecto(idProyecto: UUID, formato: FormatoExport) : Adjunto
}

' ========== CLASES EXISTENTES ==========
class Proyecto
class Etapa
class Usuario
class Cliente
class Notificacion
class ServicioNotificaciones
class HistorialEtapa
class AuditoriaProyecto
class Adjunto

' ========== TIPOS/AUXILIARES NECESARIOS ==========
class ProyectoDTO
class ListEtapas
class UUID
class TipoEvento
class FormatoExport

' ========== RELACIONES ==========
SistemaProductoraFacade --> Proyecto : crea/modifica
SistemaProductoraFacade --> Etapa : gestiona
SistemaProductoraFacade --> Usuario : recibe actor
SistemaProductoraFacade --> Notificacion : genera
SistemaProductoraFacade --> ServicioNotificaciones : usa para enviar
SistemaProductoraFacade --> AuditoriaProyecto : registra log
SistemaProductoraFacade --> HistorialEtapa : registra historial
SistemaProductoraFacade --> Adjunto : genera reportes

@enduml
