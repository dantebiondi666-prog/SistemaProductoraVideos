@startuml Diagrama_LSP_Extendido_ES
title LSP — Sistema Productora de Videos

skinparam classAttributeIconSize 0
skinparam packageStyle rectangle

class Proyecto {
  - projectId: UUID
  - nombre: String
  - cliente: String
  - fechaInicioEstimada: Date
  - fechaFinEstimada: Date
  - estado: EstadoProyecto
  - observaciones: String
  + agregarEtapa()
  + eliminarEtapa()
  + obtenerDuracionPromedioEtapas(): Duration
  + finalizarSiCorresponde(): void
}

class Etapa {
  - stageId: UUID
  - nombre: String
  + estadoActual: EstadoEtapa
  - fechaInicioEstimada: Date
  - fechaFinEstimada: Date
  - fechaFinReal: Date
  - observaciones: String
  - responsable: Usuario
  + asignarResponsable()
  + cambiarEstado(nuevo: EstadoEtapa)
  + agregarComentario()
  + adjuntar()
}

abstract class Usuario {
  - userId: UUID
  - nombre: String
  - email: String
  - rol: RolUsuario
  - canalPreferido: String
  + puedeGestionarProyectos(): boolean
  + puedeGestionarEtapas(): boolean
  + notificar()
}
class Admin
class Coordinador
class Colaborador
Usuario <|-- Admin
Usuario <|-- Coordinador
Usuario <|-- Colaborador

class Comentario {
  - commentId: UUID
  - texto: String
  - fechaHora: DateTime
  - autor: Usuario
  + editarTexto()
  + eliminar()
  + mencionar()
}

class Adjunto {
  - attachId: UUID
  - titulo: String
  - url: String
  - tipo: String
  - fechaAdjunto: DateTime
  + generarPreview()
  + descargar()
  + eliminar()
}

class Notificacion {
  - notificationId: UUID
  - asunto: String
  - mensaje: String
  - fechaHora: DateTime
  - destino: Usuario
  - resultado: String
  + marcarLeida(): void
  + programarEnvio(): void
  + pendiente(): boolean
}

interface CanalNotificacion {
  + enviar(n: Notificacion): ResultadoEnvio
}
class CanalEmail
class CanalWhatsApp
class CanalPush
class ServicioNotificaciones
CanalEmail ..|> CanalNotificacion
CanalWhatsApp ..|> CanalNotificacion
CanalPush ..|> CanalNotificacion
ServicioNotificaciones ..|> CanalNotificacion

abstract class EstadoEtapa {
  + cambiarEstado(e: Etapa, nuevo: EstadoEtapa)
  + agregarComentario(e: Etapa, c: Comentario)
}
class Pendiente
class EnCurso
class Finalizada
EstadoEtapa <|-- Pendiente
EstadoEtapa <|-- EnCurso
EstadoEtapa <|-- Finalizada


EstadoEtapa ..> Etapa : contexto

' Relaciones del dominio (sin cambios)
Proyecto "1" o-- "1..*" Etapa : contiene
Etapa "0..*" o-- "0..*" Comentario : registra
Etapa "0..*" o-- "0..*" Adjunto : adjunta
Etapa "1" --> "1" Usuario : responsable
Etapa "1" *-- "1" EstadoEtapa : estadoActual
Notificacion --> Usuario : destino
Notificacion --> Etapa : sobre


Usuario --> CanalNotificacion : usa

@enduml
