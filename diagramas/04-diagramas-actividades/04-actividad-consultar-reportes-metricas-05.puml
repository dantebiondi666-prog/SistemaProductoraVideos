@startuml 04-actividad-consultar-reportes-metricas-05
title CU05 – Consultar Reportes/Métricas (RF05)

skinparam activity {
  ArrowThickness 1.2
  BorderColor #555
  BackgroundColor #fff6ea
}
skinparam Shadowing false

|Actor (Productor/Coordinador)|
start
:Accede a la sección "Reportes";

|Sistema de Reportes|
:Verificar autenticación y permisos;
if (¿Usuario con permisos?) then (No)
  :Mostrar error "Permisos insuficientes";
  |Actor (Productor/Coordinador)|
  :Visualiza mensaje de error;
  end
endif

|Sistema de Reportes|
:Mostrar filtros disponibles;
note right
  • cliente
  • tipo
  • fechas
end note

|Actor (Productor/Coordinador)|
:Configurar y aplicar filtros;

while (¿Desea ajustar filtros?) is (Sí)
  :Modificar filtros;

  |Sistema de Reportes|
  :Consultar datos según filtros;
  :Calcular métricas;
  note right
    Ejemplos:
    • Proyectos finalizados por mes
    • Duración promedio de etapas
    • Tipo de proyecto más frecuente
  end note

  if (¿Hay datos?) then (Sí)
    :Renderizar visualizaciones (tabla/gráfico);
  else (No)
    :Mostrar "Sin resultados";
    note right
      Exportación deshabilitada sin datos
    end note
  endif

  |Actor (Productor/Coordinador)|
  :Revisar resultados;
endwhile

|Sistema de Reportes|
if (¿Hay datos?) then (Sí)
  |Actor (Productor/Coordinador)|
  if (¿Exportar resumen?) then (Sí)
    |Sistema de Reportes|
    :Solicitar exportación (PDF/CSV);

    |Servicio de Exportación|
    :Generar archivo (PDF/CSV);
    :Entregar archivo al sistema;

    |Sistema de Reportes|
    :Proveer enlace/descarga al actor;

    |Actor (Productor/Coordinador)|
    :Descargar/guardar el archivo;
  endif
else (No)
  :Mantener navegación sin exportación;
endif

|Sistema de Reportes|
:Finalizar interacción en Reportes;
note right
  Postcondiciones:
  • Reporte visualizado (si hay datos)
  • Exportación disponible (si se solicitó)
end note
stop
@enduml