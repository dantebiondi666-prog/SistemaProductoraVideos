@startuml
skinparam sequenceArrowThickness 2
skinparam roundcorner 20
skinparam maxmessagesize 60
skinparam sequenceParticipant underline

actor Coordinador as coord
participant "PantallaEtapas:ui" as ui
participant "ServicioEtapas:ctrl" as ctrl
participant "Validador:val" as val
participant "Etapa:etapa" as etapa
participant "INotificador:notif" as notif

' ==== Disparo ====
coord -> ui: iniciarGestionEtapas(idProyecto)
activate ui
ui -> ctrl: agregarEtapa(idProyecto, datosEtapa)
activate ctrl

' ==== Validación (objeto temporal) ====
ctrl -> val: normalizar(datosEtapa)
activate val
val --> ctrl: datosNormalizados
ctrl -> val: validarDatos(datosNormalizados)
val --> ctrl: resultado(ok, errores)
destroy val

' ==== Rama principal: Validación OK / Error ====
alt [ok == true]
  ' ===== Dominio (crear y guardar) =====
  ctrl -> etapa: inicializar(idProyecto, datosNormalizados)
  activate etapa
  etapa --> ctrl: inicializada

  ctrl -> etapa: guardar()
  etapa --> ctrl: idEtapa

  ' ===== Auditoría (implícita en ctrl o servicio aparte) =====
  ctrl -> ctrl: registrarEvento("ALTA_ETAPA", idProyecto, idEtapa)

  ' ===== Notificación al responsable =====
  ctrl -> notif: notificarAltaEtapa(idProyecto, idEtapa, responsable)
  activate notif
  notif --> ctrl: recibido

  ' (extra para 3+ interacciones)
  ctrl -> notif: programarRecordatorio(idEtapa, fechaRecordatorio)
  notif --> ctrl: recordatorioProgramado
  deactivate notif

  ' ===== Confirmación UI =====
  ctrl --> ui: okAltaEtapa(idEtapa)
  deactivate etapa
else [ok == false]
  ctrl --> ui: errorValidacion(errores)
  ui -> coord: mostrarErrores(errores)
  coord -> ui: reenviarDatos(datosCorregidos)
  ui -> ctrl: agregarEtapa(idProyecto, datosCorregidos)
end

' ==== Cierre / navegación (simple) ====
deactivate ctrl
ui -> coord: mostrarConfirmacion(idEtapa)
coord -> ui: verDetalleEtapa(idEtapa)
ui --> coord: detalleEtapaCargado(idEtapa)
deactivate ui
@enduml